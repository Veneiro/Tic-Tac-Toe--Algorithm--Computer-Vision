// Inicializamos la estructura con los arrays definidos arriba
Voz v1 = {buzzer1, 0, notas4, ritmo4, nullptr, COUNT_OF(notas4), 0, 0};
Voz v2 = {buzzer2, 1, notas5, ritmo5, nullptr, COUNT_OF(notas5), 0, 0};
Voz v3 = {buzzer3, 2, notas6, ritmo6, nullptr, COUNT_OF(notas6), 0, 0};

void ajustarTempo(Voz &v, int bpm) {
  // Reservamos memoria dinámica solo una vez según el tamaño calculado
  v.duraciones = new int[v.totalNotas];

  double msPorNegra = 60000.0 / bpm;
  for (int i = 0; i < v.totalNotas; i++) {
    v.duraciones[i] = (int)(v.ritmo[i] * msPorNegra);
  }
}

void setup() {
  Serial.begin(115200);

  // El sistema calcula los tiempos y reservas automáticamente
  ajustarTempo(v1, BPM);
  ajustarTempo(v2, BPM);
  ajustarTempo(v3, BPM);

  // Tu hack de hardware para separar timers
  ledcAttachChannel(buzzer1, 1000, 10, v1.canal);
  ledcAttachChannel(buzzer2, 1000, 8,  v2.canal);
  ledcAttachChannel(buzzer3, 1000, 12, v3.canal);

  Serial.println("Sistema Automatizado listo.");
  Serial.println("Comandos: [p]Play, [a]Pause, [s]Stop");
}

void silenciarVoz(Voz &v) { ledcWriteTone(v.pin, 0); }

void resetVoz(Voz &v) {
  v.notaActual = 0;
  v.tiempoInicioNota = 0;
  silenciarVoz(v);
}

void tocarVoz(Voz &v) {
  if (estadoActual != PLAY) return;

  unsigned long tiempoActual = millis();
  unsigned long elapsed = tiempoActual - v.tiempoInicioNota;

  int duracion = v.duraciones[v.notaActual];

  // Punto donde apagamos la nota para articular
  int corte = duracion * 0.90;

  // Último 10% = silencio
  if (elapsed >= corte && elapsed < duracion) {
    ledcWriteTone(v.pin, 0);
  }

  // Siguiente nota
  if (elapsed >= duracion) {

    v.notaActual++;

    if (v.notaActual >= v.totalNotas) {
      v.notaActual = 0;
    }

    double freq = v.notas[v.notaActual];

    if (freq < 50 && freq > 0)
      freq = 0;

    ledcWriteTone(v.pin, freq);

    v.tiempoInicioNota = tiempoActual;
  }
}

void loop() {
  if (Serial.available() > 0) {
    char cmd = Serial.read();

    if (cmd == 'p') {
      estadoActual = PLAY;
      // --- CORRECCIÓN: Lanzar primera nota inmediatamente ---
      ledcWriteTone(v1.pin, v1.notas[0]);
      ledcWriteTone(v2.pin, v2.notas[0]);
      ledcWriteTone(v3.pin, v3.notas[0]);
      v1.tiempoInicioNota = millis();
      v2.tiempoInicioNota = millis();
      v3.tiempoInicioNota = millis();
      // ------------------------------------------------------
      Serial.println("Play");
    }
    else if (cmd == 'a') {
      estadoActual = PAUSE;
      silenciarVoz(v1);
      silenciarVoz(v2);
      silenciarVoz(v3);
      Serial.println("Pause");
    }
    else if (cmd == 's') {
      estadoActual = STOP;
      resetVoz(v1);
      resetVoz(v2);
      resetVoz(v3);
      Serial.println("Stop");
    }
  }

  tocarVoz(v1);
  tocarVoz(v2);
  tocarVoz(v3);
}
